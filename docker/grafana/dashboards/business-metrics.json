{
  "uid": "meal-planner-business",
  "title": "Meal Planner — Business Metrics",
  "tags": ["meal-planner", "business"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Генераций плана (всего)",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(orchestrator_jobs_requested_total{type=\"GENERATE_MEAL_PLAN\"})",
        "legendFormat": "Генераций"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Замен блюда (всего)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }] } } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(orchestrator_jobs_requested_total{type=\"REPLACE_DISH\"})",
        "legendFormat": "Замен"
      }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Активных джобов",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] } } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "orchestrator_jobs_active",
        "legendFormat": "Активных"
      }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Успешных (24ч)",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(increase(orchestrator_jobs_finished_total{status=\"COMPLETED\"}[24h]))",
        "legendFormat": "Успешных"
      }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Ошибок (24ч)",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(increase(orchestrator_jobs_finished_total{status=\"FAILED\"}[24h]))",
        "legendFormat": "Ошибок"
      }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Запросы джобов по времени",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(orchestrator_jobs_requested_total{type=\"GENERATE_MEAL_PLAN\"}[5m])",
          "legendFormat": "Генерация плана"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(orchestrator_jobs_requested_total{type=\"REPLACE_DISH\"}[5m])",
          "legendFormat": "Замена блюда"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Исходы джобов",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(orchestrator_jobs_finished_total{status=\"COMPLETED\"}[5m])",
          "legendFormat": "Успешно — {{type}}"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(orchestrator_jobs_finished_total{status=\"FAILED\"}[5m])",
          "legendFormat": "Ошибка — {{type}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Всего пользователей",
      "gridPos": { "x": 0, "y": 12, "w": 6, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }] } } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "auth_users_registered",
        "legendFormat": "Пользователей"
      }]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Новых регистраций (24ч)",
      "gridPos": { "x": 6, "y": 12, "w": 6, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "increase(auth_registrations_total[24h])",
        "legendFormat": "Регистраций"
      }]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Входов за 24ч",
      "gridPos": { "x": 12, "y": 12, "w": 6, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "increase(auth_logins_total[24h])",
        "legendFormat": "Входов"
      }]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Регистрации и входы по времени",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(auth_registrations_total[10m])",
          "legendFormat": "Регистрации"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(auth_logins_total[10m])",
          "legendFormat": "Входы"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP запросы через Gateway (rps)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum by(uri) (rate(http_server_requests_seconds_count{job=\"api-gateway\"}[1m]))",
        "legendFormat": "{{uri}}"
      }]
    }
  ]
}
