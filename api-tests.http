### 3.1 Получить список блюд (с пагинацией)
# Ожидание: 200 OK, Page<DishSummaryResponse> — content, totalElements и т.д.
# Фильтры: mealType, cuisine, minCalories, maxCalories, excludeAllergens, title
GET http://localhost:8083/api/v1/dishes?mealType=BREAKFAST&page=0&size=5
Authorization: Bearer {{accessToken}}

> {%
  client.test("Status 200 OK", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
  client.test("Has content array", function() {
    client.assert(Array.isArray(response.body.content), "content is not array");
  });
  if (response.body.content && response.body.content.length > 0) {
    client.global.set("dishId", response.body.content[0].id);
  }
%}

###

