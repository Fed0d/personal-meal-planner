### 7.1 Запрос без токена → 401
GET http://localhost:8082/api/v1/users/me

> {%
  client.test("Status 401 Unauthorized", function() {
    client.assert(response.status === 401, "Expected 401, got " + response.status);
  });
%}

###

### 7.2 Обращение к SERVICE-эндпоинту с USER-токеном → 403
# Создать план питания с токеном пользователя — должно вернуть 403
POST http://localhost:8084/api/v1/meal-plans
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "userId": "00000000-0000-0000-0000-000000000001",
  "date": "2026-05-15",
  "items": [
    {
      "mealSlot": "BREAKFAST",
      "dishId": "00000000-0000-0000-0000-000000000101",
      "dishName": "Тест",
      "calories": 100.0
    }
  ]
}

> {%
  client.test("Status 403 Forbidden", function() {
    client.assert(response.status === 403, "Expected 403, got " + response.status);
  });
%}

###

### 7.3 Задача другого пользователя → 403
# Подставьте UUID задачи, созданной другим пользователем
GET http://localhost:8085/api/v1/orchestrator/tasks/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{accessToken}}

> {%
  client.test("Status 403 or 404", function() {
    client.assert(response.status === 403 || response.status === 404,
      "Expected 403 or 404, got " + response.status);
  });
%}

