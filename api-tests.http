# Невалидные данные (heightCm=5) → 400 Bad Request
PUT http://localhost:8082/api/v1/users/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "firstName": "Иван",
  "lastName": "Петров",
  "birthDate": "1995-03-15",
  "gender": "MALE",
  "heightCm": 178,
  "weightKg": 80.5,
  "targetWeightKg": 75.0,
  "goalType": "LOSE_WEIGHT",
  "activityLevel": "MODERATE"
}

> {%
  client.test("Status 200 OK", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
  client.test("firstName saved", function() {
    client.assert(response.body.firstName === "Иван", "firstName mismatch");
  });
%}

