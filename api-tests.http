Content-Type: application/json

{
  "userId": "00000000-0000-0000-0000-000000000001",
  "date": "2026-05-10",
  "items": [
    {
      "mealSlot": "BREAKFAST",
      "dishId": "00000000-0000-0000-0000-000000000101",
      "dishName": "Овсянка с ягодами",
