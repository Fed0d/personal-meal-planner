### ============================================================
###  MEAL PLANNER — API TESTS (IntelliJ HTTP Client)
###
###  Порядок выполнения:
###    1. Register / Login — получаем токены
###    2. User Service    — заполняем профиль и анкету
###    3. Meal Service    — проверяем блюда
###    4. Orchestrator    — запускаем генерацию плана питания
###    5. Meal Plan Srv   — смотрим созданный план
###    6. Orchestrator    — заменяем блюдо в плане
###    7. Краевые случаи  — 401, 403, 404, 422
###
###  Переменные (заполняются автоматически через post-response scripts):
###    {{accessToken}}   — JWT пользователя
###    {{refreshToken}}  — refresh token
###    {{serviceToken}}  — JWT сервиса (ROLE_SERVICE)
###    {{jobId}}         — id задачи из оркестратора
###    {{mealPlanId}}    — id плана питания
###    {{dishId}}        — id блюда из meal-service
### ============================================================

# ──────────────────────────────────────────────
# 1. AUTH SERVICE  (port 8081)
# ──────────────────────────────────────────────

### 1.1 Регистрация нового пользователя
# Ожидание: 201 Created, тело {"accessToken":"...","refreshToken":"..."}
# Повторная регистрация с тем же email → 409 Conflict
POST http://localhost:8081/api/v1/auth/register
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "Password123"
}

> {%
  client.test("Status 201 Created", function() {
    client.assert(response.status === 201, "Expected 201, got " + response.status);
  });
  client.test("Response has tokens", function() {
    client.assert(response.body.accessToken !== undefined, "accessToken missing");
    client.assert(response.body.refreshToken !== undefined, "refreshToken missing");
  });
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
%}

###

### 1.2 Логин существующего пользователя
# Ожидание: 200 OK, новая пара токенов
# Неверный пароль → 401 Unauthorized
POST http://localhost:8081/api/v1/auth/login
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "Password123"
}

> {%
  client.test("Status 200 OK", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
%}

###

### 1.3 Обновление access-токена через refresh
# Ожидание: 200 OK, новая пара токенов
# Истёкший или чужой refresh → 401
POST http://localhost:8081/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
  client.test("Status 200 OK", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
%}

###

### 1.4 Получение информации о текущем пользователе (/me)
# Ожидание: 200 OK, {"id":"...","email":"testuser@example.com","role":"USER"}
# Без токена → 401
GET http://localhost:8081/api/v1/auth/me
Authorization: Bearer {{accessToken}}

> {%
  client.test("Status 200 OK", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
  client.test("Email matches", function() {
    client.assert(response.body.email === "testuser@example.com", "Email mismatch");
  });
%}

###

### 1.5 Получение сервисного токена (service-to-service)
# Ожидание: 200 OK, {"accessToken":"..."} — токен с ROLE_SERVICE
# Неверный apiKey → 401
POST http://localhost:8081/api/v1/auth/service/token
Content-Type: application/json

{
  "apiKey": "default-service-secret-key"
}

> {%
  client.test("Status 200 OK", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
  client.global.set("serviceToken", response.body.accessToken);
%}

###

### 1.6 Выход (logout) — инвалидация refresh-токена
# Ожидание: 200 OK, {"message":"Logged out successfully"} (или аналог)
POST http://localhost:8081/api/v1/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
  client.test("Status 200 OK", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
%}

###
### Перелогиниться после logout, чтобы получить свежий токен
POST http://localhost:8081/api/v1/auth/login
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "Password123"
}

> {%
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
%}

