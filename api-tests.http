# ──────────────────────────────────────────────
# 6. ОРКЕСТРАТОР — замена блюда в плане
# ──────────────────────────────────────────────

### 6.1 Запросить замену блюда
# Ожидание: 202 Accepted, JobResponse {status:"PENDING", type:"REPLACE_DISH"}
# Kafka публикует replace.mealplan.command → meal-plan-service находит замену
# → публикует job.updated.event → оркестратор обновляет Job
# Несуществующий mealPlanId — ошибка придёт через Kafka (Job → FAILED)
POST http://localhost:8085/api/v1/orchestrator/plans/replace
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "mealPlanId": "{{mealPlanId}}",
  "mealSlot": "LUNCH",
  "currentDishId": "00000000-0000-0000-0000-000000000102"
}

> {%
  client.test("Status 202 Accepted", function() {
    client.assert(response.status === 202, "Expected 202, got " + response.status);
  });
  client.test("type is REPLACE_DISH", function() {
    client.assert(response.body.type === "REPLACE_DISH", "type mismatch");
  });
  client.global.set("replaceJobId", response.body.id);
%}

###

### 6.2 Проверить статус задачи на замену (повторить через несколько секунд)
# Ожидание: 200 OK, статус COMPLETED или FAILED с resultMessage
# COMPLETED — блюдо заменено в meal-plan-service
# FAILED — resultMessage содержит описание ошибки
GET http://localhost:8085/api/v1/orchestrator/tasks/{{replaceJobId}}
Authorization: Bearer {{accessToken}}

> {%
  client.test("Status 200 OK", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
  client.log("Job status: " + response.body.status);
  if (response.body.resultMessage) {
    client.log("Result: " + response.body.resultMessage);
  }
%}

# ──────────────────────────────────────────────
# 7. КРАЕВЫЕ СЛУЧАИ И БЕЗОПАСНОСТЬ
