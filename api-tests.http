### 3.4 Создать блюдо вручную
# Ожидание: 201 Created, DishResponse с заполненными полями
# Если id уже существует — зависит от реализации (400 или upsert)
POST http://localhost:8083/api/v1/dishes
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "id": 999999,
  "url": "https://example.com/dishes/test-dish",
  "title": "Тестовая овсянка с ягодами",
  "description": "Питательная и быстрая овсяная каша",
  "dishImage": "https://example.com/images/oatmeal.jpg",
  "calories": 320.5,
  "protein": 12.0,
  "fat": 6.5,
  "carbs": 55.0,
  "readyIn": "10 мин",
  "kitchenTime": "5 мин",
  "cuisine": "slavic",
  "categoryPath": "Завтраки / Каши",
  "recipe": "Залить овсяные хлопья кипятком, настоять 5 минут, добавить ягоды.",
  "mealType": "BREAKFAST",
  "allergens": ["GLUTEN"],
  "ingredients": ["овсяные хлопья", "ягоды", "мёд", "вода"]
}

> {%
  client.test("Status 201 Created", function() {
    client.assert(response.status === 201, "Expected 201, got " + response.status);
  });
  client.test("title matches", function() {
    client.assert(response.body.title === "Тестовая овсянка с ягодами", "title mismatch");
  });
%}

# ──────────────────────────────────────────────
# 4. MEAL PLAN ORCHESTRATOR  (port 8085)
# ──────────────────────────────────────────────

### 4.1 Запросить генерацию плана питания
# Ожидание: 202 Accepted, JobResponse {id, status:"PENDING", type:"GENERATE_MEAL_PLAN"}
# Kafka публикует generate.mealplan.command → meal-plan-service обрабатывает
# → публикует job.updated.event → оркестратор обновляет Job до COMPLETED/FAILED
# Дата в прошлом → 400 (нарушение @FutureOrPresent)
POST http://localhost:8085/api/v1/orchestrator/plans/generate
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "date": "2026-05-12"
}

> {%
  client.test("Status 202 Accepted", function() {
    client.assert(response.status === 202, "Expected 202, got " + response.status);
  });
  client.test("status is PENDING", function() {
    client.assert(response.body.status === "PENDING", "Expected PENDING, got " + response.body.status);
  });
  client.test("type is GENERATE_MEAL_PLAN", function() {
    client.assert(response.body.type === "GENERATE_MEAL_PLAN", "type mismatch");
  });
  client.global.set("jobId", response.body.id);
%}

###

### 4.2 Получить список всех задач пользователя
# Ожидание: 200 OK, массив JobResponse, отсортированный по createdAt desc
# Без токена → 401
GET http://localhost:8085/api/v1/orchestrator/tasks
Authorization: Bearer {{accessToken}}

> {%
  client.test("Status 200 OK", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
  client.test("Is array", function() {
    client.assert(Array.isArray(response.body), "Expected array");
  });
  client.test("At least one job", function() {
    client.assert(response.body.length >= 1, "Expected at least 1 job");
  });
%}

###

### 4.3 Получить конкретную задачу по id
# Ожидание: 200 OK, один JobResponse
# Чужой jobId → 403 Forbidden
# Несуществующий → 404 Not Found
GET http://localhost:8085/api/v1/orchestrator/tasks/{{jobId}}
Authorization: Bearer {{accessToken}}

> {%
  client.test("Status 200 OK", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
  client.test("id matches", function() {
    client.assert(response.body.id === client.global.get("jobId"), "id mismatch");
  });
  client.test("status is valid", function() {
    const valid = ["PENDING", "IN_PROGRESS", "COMPLETED", "FAILED"];
    client.assert(valid.includes(response.body.status), "Unknown status: " + response.body.status);
  });
%}

# ──────────────────────────────────────────────
# 5. MEAL PLAN SERVICE  (port 8084)
#    (Read endpoints — проверяем, что план создан)
# ──────────────────────────────────────────────

### 5.1 Получить все планы питания текущего пользователя
# Ожидание: 200 OK, список MealPlanSummaryResponse (может быть пуст до завершения джобы)
# Без токена → 401
GET http://localhost:8084/api/v1/meal-plans/my
Authorization: Bearer {{accessToken}}

> {%
  client.test("Status 200 OK", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
  client.test("Is array", function() {
    client.assert(Array.isArray(response.body), "Expected array");
  });
  if (response.body.length > 0) {
    client.global.set("mealPlanId", response.body[0].id);
  }
%}

###

### 5.2 Получить план питания на конкретную дату
# Ожидание: 200 OK, MealPlanResponse для этой даты
# Нет плана на дату → 404 Not Found
GET http://localhost:8084/api/v1/meal-plans/my/date/2026-05-05
Authorization: Bearer {{accessToken}}

> {%
  client.test("Status 200 or 404", function() {
    client.assert(response.status === 200 || response.status === 404,
      "Unexpected status: " + response.status);
  });
  if (response.status === 200) {
    client.global.set("mealPlanId", response.body.id);
    client.test("date matches", function() {
      client.assert(response.body.date === "2026-05-05", "date mismatch");
    });
    client.test("has items", function() {
      client.assert(Array.isArray(response.body.items), "items is not array");
    });
  }
%}

###

### 5.3 Получить план питания по id
# Ожидание: 200 OK, MealPlanResponse с items
# Чужой id → 403 или 404
GET http://localhost:8084/api/v1/meal-plans/{{mealPlanId}}
Authorization: Bearer {{accessToken}}

> {%
  client.test("Status 200 OK", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
  client.test("has items array", function() {
    client.assert(Array.isArray(response.body.items), "items is not array");
  });
%}

