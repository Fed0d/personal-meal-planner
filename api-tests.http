    },
    {
      "mealSlot": "LUNCH",
      "dishId": "00000000-0000-0000-0000-000000000102",
      "dishName": "Куриный суп",
      "calories": 450.0
    },
    {
      "mealSlot": "DINNER",
      "dishId": "00000000-0000-0000-0000-000000000103",
      "dishName": "Рыба на пару с овощами",
